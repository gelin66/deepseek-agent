# DSE environment example
#
# Copy this file to `.env` only for local development. `.env` is ignored.
# Shell-exported values override the same settings in ~/.dse/config.toml.
# Uncomment only the values you need and never commit a real credential.

# Official DeepSeek API
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# DSE product paths and model-setting aliases
# DSE_HOME=~/.dse
# DSE_CONFIG_PATH=~/.dse/config.toml
# DSE_BASE_URL=https://api.deepseek.com
# DSE_MODEL=deepseek-v4-pro

# Human output and local execution posture
# DSE_OUTPUT_MODE=text
# DSE_VERBOSITY=normal
# DSE_LOG_LEVEL=info
# DSE_TELEMETRY=false
# DSE_ALLOW_SHELL=true
# DSE_ASCII_SAFE=false

# Optional local extension paths
# DSE_SKILLS_DIR=~/.dse/skills
# DSE_MCP_CONFIG=~/.dse/mcp.json

# HTTP Run API authentication
# DSE_APP_SERVER_TOKEN=

# DSE accepts only the official DeepSeek model backend. There is no provider
# selector, foreign-provider credential, custom model catalog, or fallback
# provider environment variable.
