diff --git a/rust-stream-recovery/src/lib.rs b/rust-stream-recovery/src/lib.rs
--- a/rust-stream-recovery/src/lib.rs
+++ b/rust-stream-recovery/src/lib.rs
@@ -5,12 +5,24 @@ pub struct LineFramer {
 
 impl LineFramer {
     pub fn push(&mut self, chunk: &[u8]) -> Result<Vec<String>, &'static str> {
-        let text = String::from_utf8(chunk.to_vec()).map_err(|_| "invalid utf-8")?;
-        Ok(text.lines().map(str::to_owned).collect())
+        self.pending.extend_from_slice(chunk);
+        let mut lines = Vec::new();
+        while let Some(position) = self.pending.iter().position(|byte| *byte == b'\n') {
+            let mut raw: Vec<u8> = self.pending.drain(..=position).collect();
+            raw.pop();
+            if raw.last() == Some(&b'\r') {
+                raw.pop();
+            }
+            lines.push(String::from_utf8(raw).map_err(|_| "invalid utf-8")?);
+        }
+        Ok(lines)
     }
 
     pub fn finish(&mut self) -> Result<Vec<String>, &'static str> {
-        self.pending.clear();
-        Ok(Vec::new())
+        if self.pending.is_empty() {
+            return Ok(Vec::new());
+        }
+        let raw = std::mem::take(&mut self.pending);
+        Ok(vec![String::from_utf8(raw).map_err(|_| "invalid utf-8")?])
     }
 }
