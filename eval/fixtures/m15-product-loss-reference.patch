diff --git a/rust-scoped-rules/src/wire/version.rs b/rust-scoped-rules/src/wire/version.rs
--- a/rust-scoped-rules/src/wire/version.rs
+++ b/rust-scoped-rules/src/wire/version.rs
@@ -1,7 +1,26 @@
 pub fn normalize_wire_version(value: &str) -> Result<String, &'static str> {
-    let normalized = value.trim().to_ascii_lowercase();
-    if normalized.is_empty() {
+    let value = value.trim();
+    if value.is_empty() {
         return Err("empty version");
+    }
+    let mut normalized = String::with_capacity(value.len());
+    let mut previous_separator = false;
+    for character in value.chars() {
+        if character.is_ascii_alphanumeric() {
+            normalized.push(character.to_ascii_lowercase());
+            previous_separator = false;
+        } else if matches!(character, '.' | '_' | '-') {
+            if normalized.is_empty() || previous_separator {
+                return Err("invalid version");
+            }
+            normalized.push('-');
+            previous_separator = true;
+        } else {
+            return Err("invalid version");
+        }
+    }
+    if previous_separator {
+        return Err("invalid version");
     }
     Ok(normalized)
 }
