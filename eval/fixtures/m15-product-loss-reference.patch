diff --git a/python-jsonl-worker/worker.py b/python-jsonl-worker/worker.py
--- a/python-jsonl-worker/worker.py
+++ b/python-jsonl-worker/worker.py
@@ -3,12 +3,35 @@ import sys
 from typing import TextIO
 
 
-def serve(input_stream: TextIO, output_stream: TextIO) -> int:
-    for raw in input_stream:
-        request = json.loads(raw)
-        response = {
-            "id": request["id"],
-            "square": int(request["value"]) ** 2,
-        }
-        print(json.dumps(response), file=output_stream)
+def serve(
+    input_stream: TextIO,
+    output_stream: TextIO,
+    error_stream: TextIO = sys.stderr,
+) -> int:
+    for line_number, raw in enumerate(input_stream, 1):
+        try:
+            request = json.loads(raw)
+            if not isinstance(request, dict) or set(request) != {"id", "value"}:
+                raise ValueError("invalid shape")
+            request_id = request["id"]
+            value = request["value"]
+            if not isinstance(request_id, str) or not request_id:
+                raise ValueError("invalid id")
+            if isinstance(value, bool) or not isinstance(value, int):
+                raise ValueError("invalid value")
+        except (json.JSONDecodeError, KeyError, TypeError, ValueError):
+            error_stream.write(f"invalid request at line {line_number}\n")
+            error_stream.flush()
+            return 2
+        response = {"id": request_id, "square": value**2}
+        output_stream.write(
+            json.dumps(
+                response,
+                ensure_ascii=False,
+                sort_keys=True,
+                separators=(",", ":"),
+            )
+            + "\n"
+        )
+        output_stream.flush()
     return 0
