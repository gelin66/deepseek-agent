diff --git a/rust-netstring-recovery/src/lib.rs b/rust-netstring-recovery/src/lib.rs
--- a/rust-netstring-recovery/src/lib.rs
+++ b/rust-netstring-recovery/src/lib.rs
@@ -5,12 +5,50 @@ pub struct NetstringDecoder {
 
 impl NetstringDecoder {
     pub fn push(&mut self, chunk: &[u8]) -> Result<Vec<String>, &'static str> {
-        let text = String::from_utf8(chunk.to_vec()).map_err(|_| "invalid netstring")?;
-        Ok(vec![text])
+        self.pending.extend_from_slice(chunk);
+        let mut decoded = Vec::new();
+        loop {
+            let Some(colon) = self.pending.iter().position(|byte| *byte == b':') else {
+                if self.pending.iter().any(|byte| !byte.is_ascii_digit()) {
+                    return Err("invalid netstring");
+                }
+                return Ok(decoded);
+            };
+            let length_bytes = &self.pending[..colon];
+            if length_bytes.is_empty()
+                || length_bytes.iter().any(|byte| !byte.is_ascii_digit())
+                || (length_bytes.len() > 1 && length_bytes[0] == b'0')
+            {
+                return Err("invalid netstring");
+            }
+            let length_text =
+                std::str::from_utf8(length_bytes).map_err(|_| "invalid netstring")?;
+            let length = length_text
+                .parse::<usize>()
+                .map_err(|_| "invalid netstring")?;
+            let payload_start = colon + 1;
+            let comma = payload_start
+                .checked_add(length)
+                .ok_or("invalid netstring")?;
+            if self.pending.len() <= comma {
+                return Ok(decoded);
+            }
+            if self.pending[comma] != b',' {
+                return Err("invalid netstring");
+            }
+            let payload = std::str::from_utf8(&self.pending[payload_start..comma])
+                .map_err(|_| "invalid netstring")?
+                .to_owned();
+            self.pending.drain(..=comma);
+            decoded.push(payload);
+        }
     }
 
     pub fn finish(&mut self) -> Result<(), &'static str> {
-        self.pending.clear();
-        Ok(())
+        if self.pending.is_empty() {
+            Ok(())
+        } else {
+            Err("incomplete netstring")
+        }
     }
 }
diff --git a/rust-netstring-recovery/tests/netstring.rs b/rust-netstring-recovery/tests/netstring.rs
--- a/rust-netstring-recovery/tests/netstring.rs
+++ b/rust-netstring-recovery/tests/netstring.rs
@@ -7,2 +7,23 @@ fn decodes_one_complete_record() {
     assert_eq!(decoder.finish(), Ok(()));
 }
+
+#[test]
+fn buffers_split_and_multiple_netstrings() {
+    let mut decoder = NetstringDecoder::default();
+    assert!(decoder.push(b"5:he").unwrap().is_empty());
+    assert_eq!(
+        decoder.push(b"llo,2:ok,").unwrap(),
+        ["hello", "ok"]
+    );
+}
+
+#[test]
+fn rejects_noncanonical_lengths_invalid_utf8_and_incomplete_finish() {
+    let mut leading_zero = NetstringDecoder::default();
+    assert!(leading_zero.push(b"02:ok,").is_err());
+    let mut invalid_utf8 = NetstringDecoder::default();
+    assert!(invalid_utf8.push(b"1:\xff,").is_err());
+    let mut incomplete = NetstringDecoder::default();
+    assert!(incomplete.push(b"3:ab").unwrap().is_empty());
+    assert_eq!(incomplete.finish(), Err("incomplete netstring"));
+}
