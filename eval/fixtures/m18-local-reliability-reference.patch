diff --git a/typescript-request-id/src/core/request_id.ts b/typescript-request-id/src/core/request_id.ts
--- a/typescript-request-id/src/core/request_id.ts
+++ b/typescript-request-id/src/core/request_id.ts
@@ -1,3 +1,12 @@
 export function normalizeRequestId(value: string | undefined): string | null {
-  return value ?? null;
+  if (value === undefined) return null;
+  const normalized = value.trim().toLowerCase();
+  if (normalized.length === 0 || normalized.length > 64) return null;
+  const segments = normalized.split("-");
+  if (
+    segments.some(
+      (segment) => segment.length === 0 || !/^[a-z0-9]+$/.test(segment),
+    )
+  ) return null;
+  return normalized;
 }
