@@ -1,9 +1,43 @@
 from typing import Any
 
 
+def _scope(value: Any) -> str:
+    if not isinstance(value, str) or not value or value.startswith("/"):
+        raise ValueError("invalid scope")
+    parts = value.split("/")
+    if any(part in {"", ".", ".."} for part in parts):
+        raise ValueError("invalid scope")
+    return value
+
+
+def _values(
+    model: Any, effort: Any, scopes: Any
+) -> tuple[str, str, list[str]]:
+    if model not in {"deepseek-v4-pro", "deepseek-v4-flash"}:
+        raise ValueError("invalid model")
+    if effort not in {"high", "max"}:
+        raise ValueError("invalid effort")
+    if not isinstance(scopes, list):
+        raise TypeError("invalid scopes")
+    checked = [_scope(scope) for scope in scopes]
+    if len(checked) != len(set(checked)):
+        raise ValueError("duplicate scope")
+    return model, effort, checked
+
+
 def decode_policy(payload: dict[str, Any]) -> tuple[str, str, list[str]]:
-    return (
-        str(payload["model"]),
-        str(payload["reasoning"]),
-        list(payload["paths"]),
-    )
+    version = payload["version"]
+    if isinstance(version, bool):
+        raise TypeError("invalid version")
+    if version == 2:
+        if set(payload) != {"version", "model", "reasoning", "paths"}:
+            raise ValueError("invalid v2 policy")
+        return _values(payload["model"], payload["reasoning"], payload["paths"])
+    if version == 3:
+        if set(payload) != {"version", "route", "scopes"}:
+            raise ValueError("invalid v3 policy")
+        route = payload["route"]
+        if not isinstance(route, dict) or set(route) != {"model", "effort"}:
+            raise ValueError("invalid route")
