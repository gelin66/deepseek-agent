diff --git a/typescript-forwarded-chain/src/forwarded_chain.ts b/typescript-forwarded-chain/src/forwarded_chain.ts
index f13abed..c4851a2 100644
--- a/typescript-forwarded-chain/src/forwarded_chain.ts
+++ b/typescript-forwarded-chain/src/forwarded_chain.ts
@@ -1,3 +1,5 @@
+const MEMBER = /^[a-z0-9]+(?:[.-][a-z0-9]+)*$/;
+
 export function parseForwardedChain(
   value: string | undefined,
 ): string[] | null {
@@ -5,9 +7,25 @@ export function parseForwardedChain(
     return null;
   }
 
-  const parts = value
-    .split(",")
-    .map((part) => part.trim().toLowerCase())
-    .filter(Boolean);
-  return parts.length > 0 ? parts : null;
+  const rawParts = value.split(",");
+  if (rawParts.length === 0 || rawParts.length > 8) {
+    return null;
+  }
+
+  const parts: string[] = [];
+  const seen = new Set<string>();
+  for (const rawPart of rawParts) {
+    const part = rawPart.trim().toLowerCase();
+    if (
+      part.length === 0 ||
+      part.length > 63 ||
+      !MEMBER.test(part) ||
+      seen.has(part)
+    ) {
+      return null;
+    }
+    seen.add(part);
+    parts.push(part);
+  }
+  return parts;
 }
