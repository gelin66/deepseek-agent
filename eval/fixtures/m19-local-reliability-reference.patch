diff --git a/writer-policy-bundle/validation.py b/writer-policy-bundle/validation.py
index a9e578c..aa1e6ee 100644
--- a/writer-policy-bundle/validation.py
+++ b/writer-policy-bundle/validation.py
@@ -1,2 +1,21 @@
-def normalize_scopes(scopes):
-    return sorted(set(str(scope).strip() for scope in scopes if str(scope).strip()))
+def normalize_scopes(scopes, *, reject_duplicates=False):
+    if not isinstance(scopes, list):
+        raise ValueError("scopes must be a list")
+    normalized = []
+    for scope in scopes:
+        if not isinstance(scope, str):
+            raise ValueError("scope must be a string")
+        if (
+            not scope
+            or scope.startswith("/")
+            or scope.startswith("./")
+            or scope.endswith("/")
+            or "\\" in scope
+            or any(part in {"", ".", ".."} for part in scope.split("/"))
+        ):
+            raise ValueError("scope must be normalized and relative")
+        if scope in normalized and reject_duplicates:
+            raise ValueError("duplicate scope")
+        if scope not in normalized:
+            normalized.append(scope)
+    return sorted(normalized)
