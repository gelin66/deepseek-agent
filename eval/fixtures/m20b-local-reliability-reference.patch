     return null;
   }
+  const requests = Number(matched[1]);
+  const seconds = Number(matched[2]);
+  if (requests > 32 || seconds > 600) {
+    return null;
+  }
   return {
-    requests: fields.requests,
-    seconds: fields.seconds,
+    requests,
+    seconds,
