-      return [name?.trim(), Number.parseInt(raw ?? "", 10)];
-    }),
-  );
-  if (!(fields.requests > 0) || !(fields.seconds > 0)) {
+  const matched = /^requests=([1-9][0-9]*);seconds=([1-9][0-9]*)$/.exec(
+    value,
