 	"testing"
 )
 
@@ -14,3 +16,38 @@ func TestHealthIsReachable(t *testing.T) {
 		t.Fatalf("status = %d", response.Code)
 	}
 }
+
+func TestHealthReturnsCanonicalJSON(t *testing.T) {
+	t.Setenv("SERVICE_REGION", "test")
+	request := httptest.NewRequest(http.MethodGet, "/healthz?deep=1", nil)
+	response := httptest.NewRecorder()
+	NewHandler().ServeHTTP(response, request)
+	if response.Code != http.StatusOK {
+		t.Fatalf("status = %d", response.Code)
+	}
+	if got := response.Header().Get("Content-Type"); got != "application/json" {
+		t.Fatalf("content type = %q", got)
+	}
+	var actual map[string]any
+	if err := json.Unmarshal(response.Body.Bytes(), &actual); err != nil {
+		t.Fatal(err)
+	}
+	expected := map[string]any{
+		"deep": true, "region": "test", "status": "ok", "version": "2026.07",
+	}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("payload = %#v", actual)
+	}
+}
+
+func TestHealthRejectsUnsupportedMethods(t *testing.T) {
+	request := httptest.NewRequest(http.MethodPost, "/healthz", nil)
+	response := httptest.NewRecorder()
+	NewHandler().ServeHTTP(response, request)
+	if response.Code != http.StatusMethodNotAllowed {
+		t.Fatalf("status = %d", response.Code)
+	}
+	if got := response.Header().Get("Allow"); got != "GET, HEAD" {
+		t.Fatalf("allow = %q", got)
+	}
+}
