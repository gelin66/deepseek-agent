-  return { version: 1, model, reasoning: effort, paths: scopes };
+const MODELS = new Set(["deepseek-v4-pro", "deepseek-v4-flash"]);
+const EFFORTS = new Set(["high", "max"]);
+
+export function encodeRoute(model: string, effort: string, scopes: string[]) {
+  if (!MODELS.has(model) || !EFFORTS.has(effort) || !Array.isArray(scopes) || scopes.length === 0) {
+    throw new TypeError("invalid fixed route");
+  }
+  const canonical = [...new Set(scopes)].sort();
+  if (!canonical.every((path) =>
+    typeof path === "string" && path.length > 0 && !path.startsWith("/") &&
+    !path.split("/").some((part) => part === "" || part === "." || part === "..")
+  )) throw new TypeError("invalid scope");
+  return {
+    version: 2,
+    route: {model, effort},
+    scopes: canonical,
+  };
 }
