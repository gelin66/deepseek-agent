 pub fn canonical_header_name(raw: &str) -> Result<String, &'static str> {
-    if raw.is_empty() {
+    let trimmed = raw.trim();
+    if trimmed.is_empty() {
         return Err("header_empty");
     }
-    Ok(raw.to_ascii_lowercase())
+    let normalized = trimmed.replace('_', "-").to_ascii_lowercase();
+    if normalized.contains("..")
+        || normalized
+            .bytes()
+            .any(|byte| !(byte.is_ascii_alphanumeric() || byte == b'-'))
+    {
+        return Err("header_invalid");
+    }
+    Ok(normalized)
 }
diff --git a/typescript-protocol-map/src/protocol.ts b/typescript-protocol-map/src/protocol.ts
index 87cb6677486c925a77888973a0a741304daab208..f4f242e1b92d713eebb8d20cd7dc8500cb360f77 100644
--- a/typescript-protocol-map/src/protocol.ts
+++ b/typescript-protocol-map/src/protocol.ts
@@ -1,3 +1,17 @@
 export function canonicalRoute(raw: string): string {
-  return raw.toLowerCase();
+  const withoutSuffix = raw.trim().split(/[?#]/, 1)[0];
+  let decoded: string;
+  try {
+    decoded = decodeURIComponent(withoutSuffix);
+  } catch {
+    throw new Error("route_escape_invalid");
+  }
+  const segments = decoded.split("/").filter((part) => part.length > 0);
+  if (segments.some((part) => part === "." || part === "..")) {
+    throw new Error("route_segment_invalid");
+  }
+  if (segments.length === 0) {
+    return "/";
+  }
+  return `/${segments.join("/").toLowerCase()}`;
 }
