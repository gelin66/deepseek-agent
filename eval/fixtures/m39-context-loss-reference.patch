diff --git a/python-shard-config/config.py b/python-shard-config/config.py
index fdc9e5e4c0da950e192a9ee6518ccb9cc502c9b6..9aeb4c1d13048d9cc1e2bcda1df7447612618dca 100644
--- a/python-shard-config/config.py
+++ b/python-shard-config/config.py
@@ -1,2 +1,19 @@
 def normalize_shard_config(value):
-    return dict(value)
+    result = dict(value)
+    if "timeout" in result and "timeout_ms" in result:
+        raise ValueError("timeout_conflict")
+    if "timeout" in result:
+        seconds = result.pop("timeout")
+        if isinstance(seconds, bool) or not isinstance(seconds, int) or seconds < 0:
+            raise ValueError("timeout_invalid")
+        result["timeout_ms"] = seconds * 1000
+    timeout_ms = result.get("timeout_ms")
+    if timeout_ms is not None and (
+        isinstance(timeout_ms, bool) or not isinstance(timeout_ms, int) or timeout_ms < 0
+    ):
+        raise ValueError("timeout_invalid")
+    replicas = result.get("replicas", 1)
+    if isinstance(replicas, bool) or not isinstance(replicas, int) or replicas < 1:
+        raise ValueError("replicas_invalid")
+    result.setdefault("replicas", replicas)
+    return result
diff --git a/readonly-module-map/projection.py b/readonly-module-map/projection.py
index e562188b6bd01ec147c86d2a93adced42b55b6c8..13a768d9c54b957dc9b1a6c9a6c2c39c20d17eb2 100644
--- a/readonly-module-map/projection.py
+++ b/readonly-module-map/projection.py
@@ -1,2 +1,29 @@
+import json
+from pathlib import Path
+
+
 def deployment_order():
-    return []
+    root = Path(__file__).resolve().parent / "services"
+    modules = {}
+    for path in sorted(root.glob("*/module.json")):
+        value = json.loads(path.read_text(encoding="utf-8"))
+        if value.get("enabled") is True:
+            modules[value["name"]] = tuple(value.get("depends_on", []))
+
+    ordered = []
+    visiting = set()
+
+    def visit(name):
+        if name in ordered:
+            return
+        if name in visiting or name not in modules:
+            raise ValueError("module_graph_invalid")
+        visiting.add(name)
+        for dependency in sorted(modules[name]):
+            visit(dependency)
+        visiting.remove(name)
+        ordered.append(name)
+
+    for name in sorted(modules):
+        visit(name)
+    return ordered
