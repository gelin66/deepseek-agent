--- a/readonly-failure-handoff/src/cache.py
+++ b/readonly-failure-handoff/src/cache.py
@@ -1,2 +1,10 @@
 def is_fresh(stored_at, now, ttl):
-    return now - stored_at <= ttl
+    values = (stored_at, now, ttl)
+    if any(isinstance(value, bool) for value in values):
+        return False
+    if not all(isinstance(value, (int, float)) for value in values):
+        return False
+    if ttl < 0:
+        return False
+    age = now - stored_at
+    return 0 <= age <= ttl
