diff --git a/writer-release-artifact/metadata.py b/writer-release-artifact/metadata.py
index 5095b1e..1f05755 100644
--- a/writer-release-artifact/metadata.py
+++ b/writer-release-artifact/metadata.py
@@ -1,4 +1,22 @@
 def normalize_metadata(value):
     result = dict(value)
+    for field in ("name", "version", "platform"):
+        if not isinstance(result.get(field), str) or not result[field]:
+            raise ValueError(f"{field}_invalid")
+    result["version"] = result["version"].removeprefix("v")
+    aliases = {
+        "darwin-arm64": "aarch64-apple-darwin",
+        "macos-arm64": "aarch64-apple-darwin",
+        "linux-x64": "x86_64-unknown-linux-gnu",
+        "linux-arm64": "aarch64-unknown-linux-gnu",
+    }
+    canonical = {
+        "aarch64-apple-darwin",
+        "x86_64-unknown-linux-gnu",
+        "aarch64-unknown-linux-gnu",
+    }
+    result["platform"] = aliases.get(result["platform"], result["platform"])
+    if result["platform"] not in canonical:
+        raise ValueError("platform_invalid")
     result.setdefault("channel", "stable")
     return result
