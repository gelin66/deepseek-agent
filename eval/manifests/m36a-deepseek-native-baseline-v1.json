  "slice_contract": {
    "real_problem": "DSE has current mechanism and reliability proofs but no fresh, manually reviewed, deterministic-verifier capability baseline that distinguishes Harness, model and product-system loss on the current retry, feedback and protocol revision.",
    "acceptance": [
      "reuse only the frozen private task material and reference proofs while assigning every task a new M36 acceptance identity",
      "run one fresh position-1 trajectory per independent task on one immutable current binary, fresh workspace and fresh RunStore",
      "cover deterministic repair, large-repository localization, multi-module hard work, long-horizon reopen, service/API/UI behavior and adversarial false-completion recovery",
      "derive behavior and accounting truth independently and retain canonical localization, context, tool, edit, evidence, recovery and accounting observations",
      "keep normal production Runtime safe retry at initial plus at most two retries while Harness maximum_reruns remains zero",
      "stop before the next task on false success, identity ambiguity, observer ambiguity, unsafe evidence, unknown billing, incomplete usage or cost ceiling",
      "require one identical canonical owner_code:loss_code across at least two independent task IDs before any production candidate"
    ],
    "owner": "the existing corrected scripts/eval-m9b-fixed-pro-regression.py Harness",
    "production_delta": "zero in M36-A",
    "old_path_replaced": "feature imitation, historical result splicing, selective reruns and subjective loss attribution",
    "cutover": "retain one current M36 baseline and canonical loss matrix; delete the temporary live consumer after the decision",
    "failed_treatment_deletion": "when no repeated current loss exists, keep current production unchanged; any later treatment that fails held-out quality gates is physically deleted"
  },
