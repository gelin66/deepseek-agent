    {"id":"E01","lane":"root","objective":"单文件唯一替换","fixture":"unique-replace","verifier":"exact bytes and clean deterministic check","expected_changed_files":["src/value.txt"],"mechanism_test":"m7c_edit_unique_replacement_preserves_mode"},
